# Vercel backend project environment
APP_ENV=production
HOSTED_SERVERLESS=true
STARTUP_INVARIANTS_ENABLED=false
LOCAL_ADMIN_BOOTSTRAP_ENABLED=false

# Vercel sends this value as Authorization: Bearer <value> to cron routes.
# Use at least 16 random characters. The endpoint remains disabled when empty.
CRON_SECRET=
DURABLE_JOB_BATCH_SIZE=5
DURABLE_JOB_LEASE_SECONDS=120
DURABLE_JOB_RETRY_BASE_SECONDS=30
INTELLIGENCE_ACTIVATION_MODE=recommendation_only

# Public URL of the backend Vercel project, without /api/v1
PUBLIC_BASE_URL=https://your-api-project.vercel.app

# Use the Supabase transaction pooler URL. Keep sslmode=require.
POSTGRES_DSN=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Private S3-compatible report storage. Create a private Supabase Storage
# bucket and S3 access keys in the Supabase dashboard.
OBJECT_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_BUCKET=insightos-reports
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=REGION
DATABASE_RLS_ENABLED=true

# Generate independently; JWT_SECRET must contain at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_PREVIOUS_SECRETS_JSON=[]
# 32 random bytes encoded as base64: openssl rand -base64 32
PLATFORM_MASTER_KEY=replace-with-32-random-bytes-as-base64
PLATFORM_PREVIOUS_MASTER_KEYS_JSON=[]
CREDENTIAL_MASTER_KEY_REFERENCE=env:PLATFORM_MASTER_KEY
CREDENTIAL_MASTER_KEY_VERSION=v1

# Requests normally arrive through the same-origin frontend proxy. Include the
# frontend URL here for direct API use and preview environments if required.
CORS_ORIGINS=https://your-frontend-project.vercel.app

# Serverless mode uses eager tasks and does not connect to Redis.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_EAGER_PROPAGATES=false
RATE_LIMIT_ENABLED=false

# Start conservatively because each function instance is ephemeral.
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10
CRAWL_MAX_PAGES_PER_RUN=10
CRAWL_USE_PLAYWRIGHT=false

# Optional integrations
SERVICE_AREA_DRIVE_TIME_API_KEY=
SERVICE_AREA_DRIVE_TIME_ENDPOINT=https://api.openrouteservice.org/v2/isochrones/driving-car
SERVICE_AREA_DRIVE_TIME_TIMEOUT_SECONDS=30
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPE_GSC=https://www.googleapis.com/auth/webmasters.readonly
# Frontend destination after the backend completes the Google callback.
CUSTOMER_APP_BASE_URL=https://your-frontend-project.vercel.app
# COM1 hosted subscription billing. Keep every value server-only in Vercel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_GROWTH=
STRIPE_API_BASE_URL=https://api.stripe.com/v1
STRIPE_HTTP_TIMEOUT_SECONDS=15
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
DATA_CONNECTION_INITIAL_BACKFILL_DAYS=480
DATA_CONNECTION_SYNC_DELAY_DAYS=2
DATA_CONNECTION_SYNC_INTERVAL_HOURS=24
# Enable Chrome UX Report API and PageSpeed Insights API for this restricted key.
CRUX_API_KEY=
PAGESPEED_API_KEY=
WEBSITE_PERFORMANCE_COLLECTION_INTERVAL_HOURS=168
WEBSITE_PERFORMANCE_HTTP_TIMEOUT_SECONDS=45
AI_PROVIDER_BACKEND=mistral
MISTRAL_API_KEY=
MISTRAL_API_ENDPOINT=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-2603
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_ATTEMPTS=2
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=800
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
OTEL_EXPORTER_ENDPOINT=
