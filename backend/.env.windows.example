APP_ENV=local
CRON_SECRET=
DURABLE_JOB_BATCH_SIZE=5
DURABLE_JOB_LEASE_SECONDS=120
DURABLE_JOB_RETRY_BASE_SECONDS=30
APP_NAME=SEO Accelerator API
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
LOCAL_ADMIN_BOOTSTRAP_ENABLED=true
HOSTED_SERVERLESS=true
STARTUP_INVARIANTS_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use the Supabase transaction pooler (port 6543). Percent-encode reserved
# password characters such as @ as %40.
POSTGRES_DSN=postgresql://postgres.opzuarpdopgtpbekhzre:[URL-ENCODED-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.opzuarpdopgtpbekhzre:[URL-ENCODED-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10

JWT_SECRET=replace-with-at-least-32-random-characters
PLATFORM_MASTER_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
RATE_LIMIT_ENABLED=false

CRAWL_USE_PLAYWRIGHT=false
CRAWL_MAX_PAGES_PER_RUN=10
CRAWL_MAX_DISCOVERED_LINKS_PER_PAGE=20
CRAWL_FRONTIER_BATCH_SIZE=5

RANK_PROVIDER_BACKEND=synthetic
LOCAL_PROVIDER_BACKEND=synthetic
AUTHORITY_PROVIDER_BACKEND=synthetic
LOG_LEVEL=INFO
METRICS_ENABLED=false
