# Browser calls stay on the frontend origin so HttpOnly auth cookies remain
# first-party. next.config.mjs proxies /api/* to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# URL of the separate Vercel project whose root directory is backend.
API_PROXY_TARGET=https://your-api-project.vercel.app

NEXT_PUBLIC_EXECUTION_CONSOLE_ENABLED=true
NEXT_PUBLIC_WORDPRESS_EXECUTION_SETUP_UI=true
NEXT_PUBLIC_CUSTOMER_VISUAL_SYSTEM_V2_ENABLED=true
